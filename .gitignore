# build outputs (regenerated by `make`; released through GitHub releases)
build/

# node tooling used only to run the emulator harness
node_modules/
package-lock.json
package.json

# python tooling used only to run the stub-firmware harness (and by CI)
.venv/

# a user's own firmware image and the manifest derived from it: the image is
# never redistributable and the manifest is machine-specific
firmware/

# python bytecode from the host test suite
__pycache__/
*.pyc
